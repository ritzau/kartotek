# Install pinned tools in a subshell owned by setup-env.
source tools/activate-env "$PWD"
kartotek_download_mode=standalone
for kartotek_tool in rustup prek just; do
  bash tools/install-tool "$kartotek_tool" "$PWD" "$kartotek_download_mode" || exit 1
done

# Preserve unrelated existing hooks using prek's migration mode.
"$PWD/.cache/bin/prek" install || exit 1
